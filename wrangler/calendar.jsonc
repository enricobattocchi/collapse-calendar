// Cloudflare Workers static-assets site for _site/calendar (built by scripts/build.mjs).
// The custom domain collapse-calendar.lopo.it was attached once from wrangler.domains.calendar.jsonc;
// CI deploys with this file, so its token needs only "Workers Scripts: Edit".
{
  "name": "collapse-calendar",
  "compatibility_date": "2026-11-17",
  "assets": { "directory": "../_site/calendar" },
  "workers_dev": true,
  "observability": { "enabled": true }
}
